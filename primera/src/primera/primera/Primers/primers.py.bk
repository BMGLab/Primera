from dataclasses import dataclass
from typing import List, Dict
import py2bit

from ..Segments.sequences import Sequence, FastaRecord

@dataclass
class Primer:

    sequence : str
    tm : float = 0.0
    gc_percent : float = 0.0
    loc_start : int = 0
    loc_end : int = 0

    def __str__(self):
        return self.sequence

@dataclass
class PrimerPair:

    _id : str
    forward : Primer
    reverse : Primer
    amplicon : Sequence = Sequence("", "")
    # This will be used for probe design.
    product_size : int = 0

@dataclass
class ProbeGroup:

    probes : list
    seq : str

class Primer3ProbeInput:

    def __init__(self, records : List[Dict] = None):

        self.records = records if records else []

    @classmethod 
    def from_bed_record(cls, 
                        bedrecord, 
                        tbitpath,
                        min_tm,
                        opt_tm,
                        max_tm):

        grouped = bedrecord.df.groupby("sample_name")
        
        tbitFile = py2bit.open(tbitpath) 
        
        records = []

        for _name, groupdf in grouped:
            name = _name

            for i,j,k,l in zip(
                             groupdf["chr"].values,
                             groupdf["start"].astype(str).values,
                             groupdf["end"].astype(str).values,
                             groupdf["strand"].astype(str).values
                             ):
                
                sequence = Sequence("_",tbitFile.sequence(str(i),int(j),int(k)))
                 
                record = {
                    "SEQUENCE_ID" : f"{name}-{str(i)}",
                    "SEQUENCE_TEMPLATE" : sequence, 
                    "PRIMER_PICK_LEFT_PRIMER" : 0,
                    "PRIMER_PICK_RIGHT_PRIMER" : 0,
                    "PRIMER_PICK_INTERNAL_OLIGO" : 1,
                    "PRIMER_INTERNAL_NUM_RETURN" : 30,
                    "PRIMER_INTERNAL_MIN_TM" : float(min_tm),
                    "PRIMER_INTERNAL_OPT_TM" : float(opt_tm),
                    "PRIMER_INTERNAL_MAX_TM" : float(max_tm),
                        }
               
                record1 = {
                    "SEQUENCE_ID" : f"{name}-{str(i)}_rev",
                    "SEQUENCE_TEMPLATE" : sequence.reverse_complement(), 
                    "PRIMER_PICK_LEFT_PRIMER" : 0,
                    "PRIMER_PICK_RIGHT_PRIMER" : 0,
                    "PRIMER_PICK_INTERNAL_OLIGO" : 1,
                    "PRIMER_INTERNAL_NUM_RETURN" : 30,
                    "PRIMER_INTERNAL_MIN_TM" : float(min_tm),
                    "PRIMER_INTERNAL_OPT_TM" : float(opt_tm),
                    "PRIMER_INTERNAL_MAX_TM" : float(max_tm),
                        }


        
                records.append(record)
                records.append(record1)

        return cls(records)

    def to_file(self, filepath):

        with open(filepath,"w") as f:
            for record in self.records:
                for key,value in record.items():
                    f.write(f"{key}={value}\n")
                f.write("=\n")

class Primer3ProbeOutput:

    def __init__(self, probe_groups: Dict[str, ProbeGroup] = None):
        self.probe_groups = probe_groups if probe_groups else {}
    
    @classmethod
    def from_primer_file(cls, filepath):
        with open(filepath, "r") as f:
            data = f.read().split("=\n")
            
        segments = {}
        
        for record in data:
            if not record.strip():
                continue

            lines = record.strip().split("\n")
            record_dict = {}
            for line in lines:
                if "," in line:
                    key, value = line.split(",", 1)
                elif "=" in line:
                    key, value = line.split("=", 1)
                else:
                    continue
                record_dict[key] = value.strip()
            
            seq_id = record_dict.get("SEQUENCE_ID")
            if not seq_id:
                continue
            
            # Extract segment ID and variant info
            # Format: seg_0-chr13-18889414-18897833-106/291-chr13[_rev]
            parts = seq_id.split("-")
            variant_part = parts[-1]
            segment_id = "-".join(parts[:-1])

            if variant_part.endswith("_rev"):
                base_variant = variant_part[:-4]
            else:
                base_variant = variant_part
            
            num = int(record_dict.get("PRIMER_INTERNAL_NUM_RETURNED", 0))
            probes = []
            for i in range(num):
                p = record_dict.get(f"PRIMER_INTERNAL_{i}_SEQUENCE")
                if p:
                    probes.append(p)
            
            template = record_dict.get("SEQUENCE_TEMPLATE", "")
            
            if segment_id not in segments:
                segments[segment_id] = {}
            
            segments[segment_id][seq_id] = {
                "probes": probes,
                "template": template,
                "base_variant": base_variant
            }
        
        final_groups = {}
        
        for seg_id, group_data in segments.items():
            for seq_id, info in group_data.items():
                my_variant = info["base_variant"]
                my_probes = info["probes"]
                unique = []
                
                for probe in my_probes:
                    is_unique = True
                    for other_seq_id, other_info in group_data.items():
                        if seq_id == other_seq_id:
                            continue
                        
                        # Compare variants. 
                        # We want uniqueness against DIFFERENT variants (e.g. chr13 vs chr18).
                        # We do NOT require uniqueness against the same variant's other strand (chr13 vs chr13_rev).
                        #if other_info["base_variant"] != my_variant:
                        if probe in other_info["template"]:
                            is_unique = False
                            break
            
                    if is_unique:
                        unique.append(probe)
                
                final_groups[seq_id] = ProbeGroup(unique, info["template"])
                
        return cls(final_groups)


class Primer3Input:
                
    def __init__(self, records: List[Dict]=None):
        
        self.records = records if records else []
    
    @staticmethod
    def calculate_primer_num(sequence_len, min_size):
        
        return int(int(sequence_len) / int(min_size)) * 2 + 3
    
    @classmethod
    def from_fasta(cls, fasta_record : FastaRecord, 
                   primer_count,
                   min_size, 
                   max_size,
                   min_tm,
                   opt_tm,
                   max_tm):
        
        records = []
        
        for sequence in fasta_record.sequences:
            
            if primer_count == 0:
                primer_count = Primer3Input.calculate_primer_num(len(sequence),
                                                                 min_size)
                # Giving a static number of primers as an argument will override this.

            record = {
                     
                      "SEQUENCE_ID" : sequence.id,
                      "SEQUENCE_TEMPLATE" : str(sequence.seq),
                      "PRIMER_PRODUCT_SIZE_RANGE" : f"{min_size}-{max_size}",
                      "PRIMER_NUM_RETURN" : primer_count,
                      "PRIMER_MIN_TM" : float(min_tm),
                      "PRIMER_OPT_TM" : float(opt_tm),
                      "PRIMER_MAX_TM" : float(max_tm),
                                            }
            
            records.append(record)

        return cls(records)

    def to_file(self, filepath):

        with open(filepath,"w") as f:
            for record in self.records:
                for key,value in record.items():
                    f.write(f"{key}={value}\n")
                f.write("=\n")

class Primer3Output:
    def __init__(self, primer_pairs: List[PrimerPair]=None):
        self.primer_pairs = primer_pairs if primer_pairs else []

        # TODO : Maybe this can return a dict? Can be handy if we'll search something in it.
    
    @classmethod
    def from_matched_file(cls, filepath : str):

        primer_pairs = []

        with open(filepath, "r") as f:

            for line in f:
                
                _id, _forward, _reverse = line.replace("\n","").split("\t")

                forward = Primer(_forward)
                reverse = Primer(_reverse)

                primer_pairs.append(PrimerPair(_id, 
                                               forward, 
                                               reverse))

        return cls(primer_pairs) 

    @classmethod
    def from_primer_file(cls, filepath: str):
        primer_pairs = []
        with open(filepath, "r") as f:
            data = f.read().split("=\n")
            for record in data:
                if not record.strip():
                    continue

                lines = record.strip().split("\n")
                record_dict = {}
                for line in lines:
                    key, value = line.split(",", 1) if "," in line else line.split("=", 1)
                    record_dict[key] = value
                
                sequence_id = record_dict.get("SEQUENCE_ID", "")

                i = 0
                while True:
                    f_key = f"PRIMER_LEFT_{i}_SEQUENCE"
                    r_key = f"PRIMER_RIGHT_{i}_SEQUENCE"
                    len_key = f"PRIMER_PAIR_{i}_PRODUCT_SIZE"


                    _id = f"{sequence_id}-{i}"

                    if f_key in record_dict and r_key in record_dict:

                        forward_primer = Primer(record_dict[f_key])
                        reverse_primer = Primer(record_dict[r_key])
                        product_size = record_dict[len_key]
                        primer_pair = PrimerPair(_id, 
                                                 forward_primer, 
                                                 reverse_primer, 
                                                 product_size)

                        # TODO: Maybe the sequence id can use the segment id somewhere?
                        primer_pairs.append(primer_pair)
                        i += 1
                    else:
                        break

        return cls(primer_pairs)

    def to_file(self, filepath):
        
        with open(filepath, "w") as f:
            
            for idx, pair in enumerate(self.primer_pairs):
                # WARNING/TODO: The use of idx here may lead to bugs. The primer id should be taken from the primer3 output file.
                
                f.write(f"{pair._id}/{idx}\t{str(pair.forward)}\t{str(pair.reverse)}\n")
